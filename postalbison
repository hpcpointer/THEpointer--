<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>The Postal Bison</title>
  <link rel="stylesheet" href="postal.css">
</head>
<body>

<section class="postal-container">

  <div class="postal-header">
    <h1>📬 The Postal Bison</h1>
    <p>Your questions. Our stamp of honesty.</p>
    <a href="https://forms.gle/VQTozc2No7DVNc2c6" class="submit-btn" target="_blank">
      Submit a Letter!
    </a>
  </div>

  <!-- Featured Question -->
  <div class="postal-card">
    <h2>This Week’s Letter</h2>
    <p class="question">
      “**QUESTION ASKED*”
    </p>

    <div class="response">
      <h3>The Bison Responds</h3>
      <p>
       *BLABBER
      </p>
    </div>
  </div>

  <!-- Archive Section -->
  <div class="archive">
    <h2>📦 Previous Letters</h2>

    <div class="archive-item">
      <h4>“*OLDER QUESTION FROM PAST”</h4>
      <span>March 2026</span>
    </div>

    <div class="archive-item">
      <h4>“*OLDER QUESTION ASKED FROM PART2”</h4>
      <span>February 2026</span>
    </div>

  </div>

</section>

</body>
</html>
